  rdfs:comment "LP출자에 무조건 적용되는 자산분류인지 표시. 현재 집합투자증권 익스포져만 true."@ko .

# ════════════════════════════════════════════════════
# v1.5 추가 2: Concept_RWA_Calculation을 20개 자산분류와 연결
# ════════════════════════════════════════════════════
# 기존 매핑(BSER_Art17, App3_Ch1, App3_Ch2_Sec3, App3_Ch2_Sec6)에 더해
# 자산분류 단위 인스턴스 20개와도 명시 연결

inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_CentralGov .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_DomesticLocalGov .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_DomesticPublicEntity .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_ForeignPublicEntity .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_IntlDevBank .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Bank .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_CoveredBond .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_SecuritiesFirm .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Corporate .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_SpecializedLending .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Equity .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_HybridCapital .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Retail .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_ResidentialMortgage .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_CommercialRE .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_REDevelopment .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Defaulted .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_CIS .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Other .
inv:Concept_RWA_Calculation inv:groundedIn inv:BSER_App3_Asset_Securitization .


# ════════════════════════════════════════════════════
# v1.5 추가 3: 핵심 인스턴스에 SKOS altLabel (한국 금융 동의어)
# ════════════════════════════════════════════════════
# Gemma 4 e4b 같은 4B급 LLM의 한국 금융 동의어 처리 한계 보완
# W3C SKOS 어휘 사용 (Graphwise가 강조한 LLM Grounding의 한국어 적용 사례)

# --- BusinessProcess (단계) 동의어 ---
inv:CustomerRegistration skos:altLabel "고객등록"@ko, "거래상대방 등록"@ko, "Customer Registration"@en .
inv:InvestmentConsultation skos:altLabel "상담"@ko, "사전 상담"@ko, "Investment Consultation"@en .
inv:PreliminaryScreening skos:altLabel "사전협의"@ko, "Pre-screening"@en, "Preliminary Screening"@en .
inv:PreliminaryReview skos:altLabel "1차 검토"@ko, "Preliminary Review"@en .
inv:WorkingLevelReview skos:altLabel "실무협의"@ko, "실무 검토"@ko, "Working Level Review"@en .
inv:InvestmentProposal skos:altLabel "품의"@ko, "Investment Proposal"@en, "Proposal"@en .
inv:LimitCommitment skos:altLabel "약정"@ko, "Commitment"@en, "약정 체결"@ko .
inv:DrawdownProposal skos:altLabel "개별품의"@ko, "Drawdown Proposal"@en .
inv:PostManagement skos:altLabel "사후 관리"@ko, "Post Management"@en .

# --- RegulatoryConcept 동의어 ---
inv:Concept_TotalExposureLimit skos:altLabel "동일차주 한도"@ko, "여신한도"@ko, "신용공여 한도"@ko, "토탈 익스포져"@ko, "Total Exposure Limit"@en .
inv:Concept_RWA_Calculation skos:altLabel "위험가중자산"@ko, "RWA 산정"@ko, "Risk Weighted Asset"@en, "위험가중치 산정"@ko .
inv:Concept_AlternativeInvestmentClassification skos:altLabel "대체투자 분류"@ko, "AI 분류"@ko, "Alternative Investment Classification"@en .
inv:Concept_SoundnessGrading skos:altLabel "건전성분류"@ko, "건전성 등급"@ko, "자산분류"@ko, "Asset Quality Classification"@en .
inv:Concept_SuitabilityCheck skos:altLabel "Suitability"@en, "Suitability Rule"@en .
inv:Concept_ExplanationDuty skos:altLabel "설명 의무"@ko, "Disclosure"@en, "Explanation Duty"@en .
inv:Concept_CustomerIdentification skos:altLabel "KYC"@en, "Know Your Customer"@en, "고객확인의무"@ko, "CDD"@en .
inv:Concept_OngoingReporting skos:altLabel "지속보고"@ko, "정기보고 점검"@ko .
inv:Concept_PortfolioMonitoring skos:altLabel "포트폴리오 모니터링"@ko, "사후 모니터링"@ko .
inv:Concept_CommitmentRegistration skos:altLabel "약정 등록"@ko, "약정 체결"@ko .

# --- 거래상대방·펀드 형태 동의어 ---
inv:GP skos:altLabel "업무집행조합원"@ko, "운용사"@ko, "자산운용사"@ko, "일반사원"@ko, "Sponsor"@en, "General Partner"@en .
inv:LP skos:altLabel "유한책임사원"@ko, "조합원"@ko, "출자자"@ko, "Limited Partner"@en .
inv:FundOrPartnership skos:altLabel "펀드"@ko, "조합"@ko, "Fund"@en, "Partnership"@en .
inv:RecipientFund skos:altLabel "피투자펀드"@ko, "투자대상펀드"@ko .
inv:PortfolioCompany skos:altLabel "피투자회사"@ko, "투자대상회사"@ko, "최종 투자처"@ko .

# --- 상품 유형 동의어 ---
inv:Product_PEF skos:altLabel "사모투자합자회사"@ko, "사모펀드"@ko, "경영참여형 사모집합투자기구"@ko, "Private Equity Fund"@en .
inv:Product_NewTechFund skos:altLabel "신기술조합"@ko, "신기술펀드"@ko, "NTF"@en, "신기술사업투자조합"@ko .
inv:Product_VentureFund skos:altLabel "벤처조합"@ko, "벤처투자펀드"@ko, "VC조합"@ko, "벤처투자조합"@ko .
inv:Product_AcquisitionFinance skos:altLabel "M&A 금융"@ko, "Acquisition Finance"@en, "LBO 대출"@ko, "인수자금 대출"@ko .

# --- Investment·Commitment 동의어 ---
inv:Investment skos:altLabel "투자건"@ko, "출자건"@ko .
inv:Commitment skos:altLabel "약정"@ko, "출자약정"@ko, "Commitment Agreement"@en .
inv:DrawdownExecution skos:altLabel "개별 출자"@ko, "캐피털 콜"@ko, "Capital Call"@en, "Drawdown"@en .


# ════════════════════════════════════════════════════
# v1.6 추가 1: InvestmentBranch 클래스 (가지별 상태 추적)
# ════════════════════════════════════════════════════

inv:InvestmentBranch a owl:Class ;
  rdfs:label "투자검토브랜치"@ko ;
  rdfs:label "InvestmentBranch"@en ;
  rdfs:comment "한 상담(Consultation)에서 분기된 상품별·트렌치별 검토 단위. Investment는 상담 전체의 컨테이너이고, Branch는 각 상품(LP출자/인수금융 등)의 독립적 진행 단위. 각 Branch는 자체 단계(hasCurrentStage)와 상태(hasBranchState)를 가짐."@ko .

# Investment-Branch 관계
inv:hasBranch a owl:ObjectProperty ;
  rdfs:label "검토브랜치"@ko ;
  rdfs:domain inv:Investment ;
  rdfs:range inv:InvestmentBranch ;
  rdfs:comment "Investment(상담 컨테이너)가 가진 상품별 검토 브랜치. 1:N 관계."@ko .

inv:belongsToInvestment a owl:ObjectProperty ;
  rdfs:label "소속투자건"@ko ;
  rdfs:domain inv:InvestmentBranch ;
  rdfs:range inv:Investment ;
  owl:inverseOf inv:hasBranch .

# Branch가 가진 속성들
inv:hasCurrentStage a owl:ObjectProperty ;
  rdfs:label "현재진행단계"@ko ;
  rdfs:domain inv:InvestmentBranch ;
  rdfs:range inv:BusinessProcess ;
  rdfs:comment "이 브랜치가 현재 도달한 진행 단계 (BusinessProcess 인스턴스)."@ko .

inv:hasCurrentRecord a owl:ObjectProperty ;
  rdfs:label "현재처리건"@ko ;
  rdfs:domain inv:InvestmentBranch ;
  rdfs:range inv:ProcessRecord ;
  rdfs:comment "이 브랜치의 현재 처리건 (가장 최근 ProcessRecord 인스턴스)."@ko .

inv:hasBranchState a owl:ObjectProperty ;
  rdfs:label "브랜치상태"@ko ;
  rdfs:domain inv:InvestmentBranch ;
  rdfs:range inv:State ;
  rdfs:comment "브랜치별 현재 상태. Investment 전체 상태(hasState)와 분리됨."@ko .

inv:hasProductType a owl:ObjectProperty .  # 기존 속성 재사용 (Branch에도 적용)

# ════════════════════════════════════════════════════
# v1.6 추가 2: 실행 상태 6단계 분리
# ════════════════════════════════════════════════════
# 기존 State_Drawdown 1개를 6개 세분화 인스턴스로 분리
# (기존 State_Drawdown은 호환성 위해 유지, 새 인스턴스로 정밀 추적)

inv:State_CommitmentInProgress a owl:NamedIndividual, inv:State ;
  rdfs:label "약정진행중"@ko ;
  rdfs:label "CommitmentInProgress"@en ;
  rdfs:comment "한도약정 체결 단계 진행 중. 약정서 협상·검토 단계."@ko ;
  inv:hasStateOrder "1"^^xsd:int .

inv:State_CommitmentCompleted a owl:NamedIndividual, inv:State ;
  rdfs:label "약정체결완료"@ko ;
  rdfs:label "CommitmentCompleted"@en ;
  rdfs:comment "약정 체결 완료. 자금 인출 가능한 상태이나 아직 인출 전."@ko ;
  inv:hasStateOrder "2"^^xsd:int .

inv:State_DrawdownApprovalInProgress a owl:NamedIndividual, inv:State ;
  rdfs:label "개별출자품의진행중"@ko ;
  rdfs:label "DrawdownApprovalInProgress"@en ;
  rdfs:comment "약정한도 내 개별 출자(Capital Call) 품의 진행 중."@ko ;
  inv:hasStateOrder "3"^^xsd:int .

inv:State_DrawdownApproved a owl:NamedIndividual, inv:State ;
  rdfs:label "개별출자승인완료"@ko ;
  rdfs:label "DrawdownApproved"@en ;
  rdfs:comment "개별 출자 품의 승인 완료. 자금 납입 직전."@ko ;
  inv:hasStateOrder "4"^^xsd:int .

inv:State_FundDisbursementCompleted a owl:NamedIndividual, inv:State ;
  rdfs:label "출자금납입완료"@ko ;
  rdfs:label "FundDisbursementCompleted"@en ;
  rdfs:comment "실제 출자금이 GP에게 송금 완료. 1차/2차/N차 인출별로 발생."@ko ;
  inv:hasStateOrder "5"^^xsd:int .

inv:State_PostManagement a owl:NamedIndividual, inv:State ;
  rdfs:label "사후관리진행중"@ko ;
  rdfs:label "PostManagementInProgress"@en ;
  rdfs:comment "출자 후 운용현황·리스크 모니터링 진행."@ko ;
  inv:hasStateOrder "6"^^xsd:int .

# Branch 상태 보조 (Screening 단계 진행 중인 경우)
inv:State_ScreeningInProgress a owl:NamedIndividual, inv:State ;
  rdfs:label "사전협의진행중"@ko ;
  inv:hasStateOrder "0"^^xsd:int .

inv:State_ReviewInProgress a owl:NamedIndividual, inv:State ;
  rdfs:label "예비검토진행중"@ko ;
  inv:hasStateOrder "0"^^xsd:int .

inv:State_ReviewStalled a owl:NamedIndividual, inv:State ;
  rdfs:label "예비검토단계정체"@ko ;
  rdfs:comment "예비검토 단계에서 후속 진행 보류된 상태."@ko ;
  inv:hasStateOrder "-1"^^xsd:int .

inv:State_WorkingReviewInProgress a owl:NamedIndividual, inv:State ;
  rdfs:label "실무협의진행중"@ko .

inv:State_ProposalInProgress a owl:NamedIndividual, inv:State ;
  rdfs:label "품의진행중"@ko .

# 데이터 속성 (상태 순서)
inv:hasStateOrder a owl:DatatypeProperty ;
  rdfs:label "상태순서"@ko ;
  rdfs:domain inv:State ;
  rdfs:range xsd:int ;
  rdfs:comment "상태의 시간순 정렬을 위한 순서값. 후속 상태 도달 시 선행 상태는 완료로 추론 가능."@ko .

# ════════════════════════════════════════════════════
# v1.6 추가 3: 단계 순차성 명시
# ════════════════════════════════════════════════════
# 기존 hasNextStep 외에, "선행 단계 완료 추론"을 위한 속성

inv:precedesStage a owl:ObjectProperty ;
  rdfs:label "선행단계"@ko ;
  rdfs:domain inv:BusinessProcess ;
  rdfs:range inv:BusinessProcess ;
  owl:transitive true ;
  rdfs:comment "단계 간 선행 관계. transitive 추론으로 후속 단계 도달 시 선행 단계 완료 추론."@ko .

# 단계 순서 명시 (LP출자 표준 흐름)
inv:CustomerRegistration inv:precedesStage inv:InvestmentConsultation .
inv:InvestmentConsultation inv:precedesStage inv:PreliminaryScreening .
inv:PreliminaryScreening inv:precedesStage inv:PreliminaryReview .
inv:PreliminaryReview inv:precedesStage inv:WorkingLevelReview .
inv:WorkingLevelReview inv:precedesStage inv:InvestmentProposal .
inv:InvestmentProposal inv:precedesStage inv:LimitCommitment .
inv:LimitCommitment inv:precedesStage inv:DrawdownProposal .
inv:DrawdownProposal inv:precedesStage inv:PostManagement .

# v1.0 데모 잔재(우선주·전환사채) 폐기 마커
# Demo_Investment_001, Demo_Consultation_C2026_0042, Demo_Screening_S2026_0101/0102 등
# v1.0 시나리오는 다음과 같이 어노테이션으로 폐기 표시
inv:Demo_Investment_001 inv:isDeprecated true ;
  inv:deprecationNote "v1.0 초기 시나리오. v1.4에서 LP출자/인수금융 시나리오로 대체됨. 페이퍼 §6 'v1.0→v1.4 진화' 인용용으로만 보존."@ko .

# isDeprecated 속성
inv:isDeprecated a owl:DatatypeProperty ;
  rdfs:label "폐기여부"@ko ;
  rdfs:domain inv:Investment ;
  rdfs:range xsd:boolean .

inv:deprecationNote a owl:AnnotationProperty ;
  rdfs:label "폐기 사유"@ko .

# v1.4 데모 인스턴스(Demo_Investment_002 등) 폐기 마커
# v1.6에서 김대환님이 새로 작성할 데모로 대체 예정
inv:Demo_Investment_002 inv:isDeprecated true ;
  inv:deprecationNote "v1.4 자동 생성 시나리오. Investment-Branch 분리 부재, 약정-실행 구분 미흡. v1.6에서 도메인 전문가 직접 작성 시나리오로 대체."@ko .


# ════════════════════════════════════════════════════
# v1.7: 도메인 전문가 작성 4개 데모 시나리오
# ════════════════════════════════════════════════════
# 김대환님이 v16_demo_scenario_worksheet.xlsx에 직접 작성
# Investment-Branch-ProcessRecord 모델 적용

# ─── GP 인스턴스 추가 ───
inv:Demo_GP_ABC a owl:NamedIndividual, inv:GP ;
  rdfs:label "ABC 자산운용 (가상)"@ko .

inv:Demo_GP_vvip a owl:NamedIndividual, inv:GP ;
  rdfs:label "vvip (가상)"@ko .

inv:Demo_GP_aespa a owl:NamedIndividual, inv:GP ;
  rdfs:label "aespa (가상)"@ko .

inv:Demo_GP_itzy a owl:NamedIndividual, inv:GP ;
  rdfs:label "itzy (가상)"@ko .

# ─── RecipientFund 인스턴스 ───
inv:Demo_Fund_ABC a owl:NamedIndividual, inv:RecipientFund ;
  rdfs:label "ABC펀드"@ko ;
  inv:managedByGP inv:Demo_GP_ABC .

inv:Demo_Fund_1q2w a owl:NamedIndividual, inv:RecipientFund ;
  rdfs:label "1q2w (가상)"@ko ;
  rdfs:comment "상장사 A 인수목적 PEF"@ko ;
  inv:managedByGP inv:Demo_GP_vvip .

inv:Demo_SPC_ive a owl:NamedIndividual, inv:PortfolioCompany ;
  rdfs:label "ive (인수목적 SPC, 가상)"@ko ;
  rdfs:comment "1q2w 펀드가 설립한 인수목적 SPC. 인수금융의 차주."@ko .

inv:Demo_Fund_alldayproject a owl:NamedIndividual, inv:RecipientFund ;
  rdfs:label "alldayproject (가상)"@ko ;
  rdfs:comment "비상장사 B 발행 전환사채 인수목적 펀드"@ko ;
  inv:managedByGP inv:Demo_GP_aespa .

inv:Demo_Fund_babymonster a owl:NamedIndividual, inv:RecipientFund ;
  rdfs:label "babymonster (가상)"@ko ;
  rdfs:comment "비상장사 C 발행 CPS 인수목적 신기술조합. Pre-IPO 펀딩."@ko ;
  inv:managedByGP inv:Demo_GP_itzy .

# ════════════════════════════════════════════════════
# 시나리오 003: ABC펀드 LP출자+인수금융 동시 검토
# 상태: LP출자 1차 출자금 납입 완료 / 인수금융 예비검토 정체
# ════════════════════════════════════════════════════

inv:Demo_Investment_003 a owl:NamedIndividual, inv:Investment ;
  rdfs:label "ABC펀드 출자·인수금융 동시 검토 (가상)"@ko ;
  rdfs:comment "ABC 자산운용 GP의 신규 펀드에 대한 LP출자 + 인수금융 동시 검토."@ko ;
  inv:managedByGP inv:Demo_GP_ABC ;
  inv:hasIndirectTarget inv:Demo_Fund_ABC ;
  inv:hasBranch inv:Demo_Investment_003_B01 ,
                inv:Demo_Investment_003_B02 .

# 분기 전 공통 상담
inv:Demo_I003_C01 a owl:NamedIndividual, inv:Consultation ;
  rdfs:label "I-003 투자상담"@ko ;
  rdfs:comment "ABC펀드 검토 상담. LP출자 + 인수금융으로 분기."@ko .

# B01: LP출자 브랜치 (실행 완료)
inv:Demo_Investment_003_B01 a owl:NamedIndividual, inv:InvestmentBranch ;
  rdfs:label "003-B01 LP출자 브랜치 (50억)"@ko ;
  inv:belongsToInvestment inv:Demo_Investment_003 ;
  inv:hasProductType inv:Product_PEF ;
  inv:hasInvestmentAmount "5000000000"^^xsd:decimal ;
  inv:hasCurrentStage inv:DrawdownProposal ;
  inv:hasCurrentRecord inv:Demo_I003_B01_DE01 ;
  inv:hasBranchState inv:State_FundDisbursementCompleted .

inv:Demo_I003_B01_S01 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "I-003-B01 사전협의 (LP출자 50억)"@ko ;
  inv:precededBy inv:Demo_I003_C01 .
inv:Demo_I003_B01_R01 a owl:NamedIndividual, inv:Review ;
  rdfs:label "I-003-B01 예비검토 (LP출자)"@ko ;
  inv:precededBy inv:Demo_I003_B01_S01 .
inv:Demo_I003_B01_W01 a owl:NamedIndividual, inv:WorkingReview ;
  rdfs:label "I-003-B01 실무협의회 (LP출자)"@ko ;
  inv:precededBy inv:Demo_I003_B01_R01 .
inv:Demo_I003_B01_P01 a owl:NamedIndividual, inv:Proposal ;
  rdfs:label "I-003-B01 품의 (LP출자 50억)"@ko ;
  inv:precededBy inv:Demo_I003_B01_W01 .
inv:Demo_I003_B01_C01 a owl:NamedIndividual, inv:Commitment ;
  rdfs:label "I-003-B01 약정 (LP출자 50억)"@ko ;
  inv:precededBy inv:Demo_I003_B01_P01 ;
  inv:hasCommitmentLimit "5000000000"^^xsd:decimal .
inv:Demo_I003_B01_DP01 a owl:NamedIndividual, inv:DrawdownProposal ;
  rdfs:label "I-003-B01 1차 개별품의 (30억)"@ko ;
  inv:precededBy inv:Demo_I003_B01_C01 .
inv:Demo_I003_B01_DE01 a owl:NamedIndividual, inv:DrawdownExecution ;
  rdfs:label "I-003-B01 1차 출자금 납입 (30억)"@ko ;
  rdfs:comment "30억 송금 완료"@ko ;
  inv:precededBy inv:Demo_I003_B01_DP01 .

# B02: 인수금융 브랜치 (예비검토 정체)
inv:Demo_Investment_003_B02 a owl:NamedIndividual, inv:InvestmentBranch ;
  rdfs:label "003-B02 인수금융 브랜치 (100억)"@ko ;
  inv:belongsToInvestment inv:Demo_Investment_003 ;
  inv:hasProductType inv:Product_AcquisitionFinance ;
  inv:hasInvestmentAmount "10000000000"^^xsd:decimal ;
  inv:hasCurrentStage inv:PreliminaryReview ;
  inv:hasCurrentRecord inv:Demo_I003_B02_R01 ;
  inv:hasBranchState inv:State_ReviewStalled .

inv:Demo_I003_B02_S01 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "I-003-B02 사전협의 (인수금융 100억)"@ko ;
  inv:precededBy inv:Demo_I003_C01 .
inv:Demo_I003_B02_R01 a owl:NamedIndividual, inv:Review ;
  rdfs:label "I-003-B02 예비검토 (인수금융)"@ko ;
  rdfs:comment "예비검토 단계에서 정체. 신용리스크 보강 필요로 보류."@ko ;
  inv:precededBy inv:Demo_I003_B02_S01 .

# ════════════════════════════════════════════════════
# 시나리오 004: 상장사A 인수목적 1q2w 출자+인수금융
# 상태: 둘 다 예비검토 완료, 실무협의회 대기
# ════════════════════════════════════════════════════

inv:Demo_Investment_004 a owl:NamedIndividual, inv:Investment ;
  rdfs:label "상장사 A 인수목적 펀드 1q2w 출자 및 인수금융 검토"@ko ;
  rdfs:comment "상장사 A 인수목적으로 운용사 vvip가 설립하는 PEF 1q2w에 LP출자, 1q2w가 설립하는 인수목적 SPC인 ive에 인수금융 동시 검토. 별개 상품이므로 사전협의는 각각 수행."@ko ;
  inv:managedByGP inv:Demo_GP_vvip ;
  inv:hasIndirectTarget inv:Demo_Fund_1q2w ;
  inv:hasBranch inv:Demo_Investment_004_B01 ,
                inv:Demo_Investment_004_B02 .

inv:Demo_I004_C01 a owl:NamedIndividual, inv:Consultation ;
  rdfs:label "I-004 투자상담"@ko ;
  rdfs:comment "1q2w 펀드 LP출자 + 인수금융 동시 검토 상담."@ko .

# B01: LP출자 (예비검토 완료, 실무협의 대기)
inv:Demo_Investment_004_B01 a owl:NamedIndividual, inv:InvestmentBranch ;
  rdfs:label "004-B01 LP출자 브랜치 (10억)"@ko ;
  inv:belongsToInvestment inv:Demo_Investment_004 ;
  inv:hasProductType inv:Product_PEF ;
  inv:hasInvestmentAmount "1000000000"^^xsd:decimal ;
  inv:hasCurrentStage inv:PreliminaryReview ;
  inv:hasCurrentRecord inv:Demo_I004_B01_R01 ;
  inv:hasBranchState inv:State_ReviewInProgress ;
  rdfs:comment "실무협의회 대기 중. 엄밀히는 예비검토 완료, 실무협의 전 대기 상태 (단계 간 대기 상태 모델링은 향후 보강 예정)."@ko .

inv:Demo_I004_B01_S01 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "I-004-B01 사전협의 (LP출자 10억)"@ko ;
  inv:precededBy inv:Demo_I004_C01 .
inv:Demo_I004_B01_R01 a owl:NamedIndividual, inv:Review ;
  rdfs:label "I-004-B01 예비검토 (LP출자)"@ko ;
  rdfs:comment "예비검토 완료, 실무협의회 대기 중."@ko ;
  inv:precededBy inv:Demo_I004_B01_S01 .

# B02: 인수금융 (예비검토 완료, 실무협의 대기)
inv:Demo_Investment_004_B02 a owl:NamedIndividual, inv:InvestmentBranch ;
  rdfs:label "004-B02 인수금융 브랜치 (100억)"@ko ;
  inv:belongsToInvestment inv:Demo_Investment_004 ;
  inv:hasProductType inv:Product_AcquisitionFinance ;
  inv:hasInvestmentAmount "10000000000"^^xsd:decimal ;
  inv:hasCurrentStage inv:PreliminaryReview ;
  inv:hasCurrentRecord inv:Demo_I004_B02_R01 ;
  inv:hasBranchState inv:State_ReviewInProgress ;
  rdfs:comment "1q2w가 인수목적으로 설립하는 SPC인 ive에 인수금융. 동일 상담 LP출자와 실무협의회 동시 진행."@ko .

inv:Demo_I004_B02_S01 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "I-004-B02 사전협의 (인수금융 100억)"@ko ;
  inv:precededBy inv:Demo_I004_C01 .
inv:Demo_I004_B02_R01 a owl:NamedIndividual, inv:Review ;
  rdfs:label "I-004-B02 예비검토 (인수금융)"@ko ;
  inv:precededBy inv:Demo_I004_B02_S01 .

# ════════════════════════════════════════════════════
# 시나리오 005: 비상장사B 전환사채 펀드 alldayproject LP출자
# 상태: 사전협의 진행 중
# ════════════════════════════════════════════════════

inv:Demo_Investment_005 a owl:NamedIndividual, inv:Investment ;
  rdfs:label "비상장사 B 발행 전환사채 인수목적 펀드 alldayproject LP출자 검토"@ko ;
  rdfs:comment "비상장사 B가 1년내 IPO 계획하며 자금 조달 위해 발행 계획하는 전환사채 인수 목적 펀드 출자 검토."@ko ;
  inv:managedByGP inv:Demo_GP_aespa ;
  inv:hasIndirectTarget inv:Demo_Fund_alldayproject ;
  inv:hasBranch inv:Demo_Investment_005_B01 .

inv:Demo_I005_C01 a owl:NamedIndividual, inv:Consultation ;
  rdfs:label "I-005 투자상담"@ko ;
  rdfs:comment "alldayproject 펀드 LP출자 검토 상담."@ko .

inv:Demo_Investment_005_B01 a owl:NamedIndividual, inv:InvestmentBranch ;
  rdfs:label "005-B01 LP출자 브랜치 (40억)"@ko ;
  inv:belongsToInvestment inv:Demo_Investment_005 ;
  inv:hasProductType inv:Product_PEF ;
  inv:hasInvestmentAmount "4000000000"^^xsd:decimal ;
  inv:hasCurrentStage inv:PreliminaryScreening ;
  inv:hasCurrentRecord inv:Demo_I005_B01_S01 ;
  inv:hasBranchState inv:State_ScreeningInProgress ;
  rdfs:comment "사전협의 진행 중. 사전협의 주요 검토사항 누락 없도록 주의."@ko .

inv:Demo_I005_B01_S01 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "I-005-B01 사전협의 (LP출자 40억)"@ko ;
  rdfs:comment "사전협의 결재 중. 투자상담 단계는 완료된 것으로 간주."@ko ;
  inv:precededBy inv:Demo_I005_C01 .

# ════════════════════════════════════════════════════
# 시나리오 006: Pre-IPO 비상장사C CPS 신기술조합 babymonster LP출자
# 상태: 약정 완료, 출자금 납입 대기
# 김대환님 통찰: "분기되지 않더라도 브랜치 1개는 가짐"
# ════════════════════════════════════════════════════

inv:Demo_Investment_006 a owl:NamedIndividual, inv:Investment ;
  rdfs:label "Pre-IPO 비상장사 C 발행 CPS 인수목적 신기술조합 babymonster LP출자 10억 검토"@ko ;
  rdfs:comment "비상장사 C가 CPS 발행 추진하며 이를 인수하고자 운용사 itzy가 운용하는 신기술조합 babymonster에 10억원 출자 검토."@ko ;
  inv:managedByGP inv:Demo_GP_itzy ;
  inv:hasIndirectTarget inv:Demo_Fund_babymonster ;
  inv:hasBranch inv:Demo_Investment_006_B01 .

inv:Demo_I006_C01 a owl:NamedIndividual, inv:Consultation ;
  rdfs:label "I-006 투자상담"@ko .

inv:Demo_Investment_006_B01 a owl:NamedIndividual, inv:InvestmentBranch ;
  rdfs:label "006-B01 LP출자 브랜치 (10억)"@ko ;
  inv:belongsToInvestment inv:Demo_Investment_006 ;
  inv:hasProductType inv:Product_NewTechFund ;
  inv:hasInvestmentAmount "1000000000"^^xsd:decimal ;
  inv:hasCurrentStage inv:LimitCommitment ;
  inv:hasCurrentRecord inv:Demo_I006_B01_C01 ;
  inv:hasBranchState inv:State_CommitmentCompleted ;
  rdfs:comment "약정등록까지 완료, 출자금 납입 대기 중. 약정등록은 실제 현실에서 규약 체결 완료를 의미."@ko .

inv:Demo_I006_B01_S01 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "I-006-B01 사전협의"@ko ;
  inv:precededBy inv:Demo_I006_C01 .
inv:Demo_I006_B01_R01 a owl:NamedIndividual, inv:Review ;
  rdfs:label "I-006-B01 예비검토"@ko ;
  inv:precededBy inv:Demo_I006_B01_S01 .
inv:Demo_I006_B01_W01 a owl:NamedIndividual, inv:WorkingReview ;
  rdfs:label "I-006-B01 실무협의회"@ko ;
  inv:precededBy inv:Demo_I006_B01_R01 .
inv:Demo_I006_B01_P01 a owl:NamedIndividual, inv:Proposal ;
  rdfs:label "I-006-B01 품의등록 (약정품의)"@ko ;
  rdfs:comment "LP출자이므로 약정품의등록. (필요시 일반 품의등록과 약정품의등록 구분 가능)"@ko ;
  inv:precededBy inv:Demo_I006_B01_W01 .
inv:Demo_I006_B01_C01 a owl:NamedIndividual, inv:Commitment ;
  rdfs:label "I-006-B01 약정등록"@ko ;
  rdfs:comment "실제 현실에서 체결된 약정 정보 등록. 약정등록 완료 후 출자금 납입 대기."@ko ;
  inv:precededBy inv:Demo_I006_B01_P01 ;
  inv:hasCommitmentLimit "1000000000"^^xsd:decimal .


# ════════════════════════════════════════════════════
# v1.8 추가 1: Counterparty 메타 클래스 (거래상대방의 다층성)
# ════════════════════════════════════════════════════
# 도메인 전문가 통찰: LP출자 검토 시 GP·Fund·PortfolioCompany 모두 회사의
# 거래상대방이며 KYC·신용공여한도·적합성 검토 대상.

inv:Counterparty a owl:Class ;
  rdfs:label "거래상대방"@ko ;
  rdfs:label "Counterparty"@en ;
  skos:altLabel "거래 상대방"@ko, "거래처"@ko, "차주"@ko ;
  rdfs:comment "회사의 거래·투자 대상이 되는 모든 법인·자연인. KYC, 신용공여한도, 적합성 등 규제 적용의 1차 단위. LP출자 검토 시 GP·Fund·PortfolioCompany 모두 해당. 한국 자본시장법·금소법의 '거래상대방' 개념과 정합."@ko .

# Customer를 Counterparty와 동등 선언 (기존 모델 호환)
inv:Customer owl:equivalentClass inv:Counterparty .

# 기존 클래스들을 Counterparty 하위로 명시 추가
inv:GP rdfs:subClassOf inv:Counterparty .
inv:RecipientFund rdfs:subClassOf inv:Counterparty .
inv:PortfolioCompany rdfs:subClassOf inv:Counterparty .
inv:FundOrPartnership rdfs:subClassOf inv:Counterparty .

# 거래상대방 역할 표현 (한 인스턴스가 여러 역할 가능)
inv:hasCounterpartyRole a owl:ObjectProperty ;
  rdfs:label "거래상대방역할"@ko ;
  rdfs:domain inv:Counterparty ;
  rdfs:range owl:Class ;
  rdfs:comment "한 거래상대방이 가질 수 있는 역할(GP·LP·차주·피투자 등). 한 법인이 여러 역할 동시 가능."@ko .

inv:Role_GP a owl:Class ;
  rdfs:label "GP 역할"@ko ;
  rdfs:comment "펀드 운용사 역할"@ko .
inv:Role_LP a owl:Class ;
  rdfs:label "LP 역할"@ko ;
  rdfs:comment "유한책임조합원 역할"@ko .
inv:Role_Borrower a owl:Class ;
  rdfs:label "차주 역할"@ko ;
  rdfs:comment "대출·인수금융 차주 역할"@ko .
inv:Role_PortfolioTarget a owl:Class ;
  rdfs:label "피투자 대상 역할"@ko ;
  rdfs:comment "펀드를 통해 최종 투자되는 회사 역할"@ko .

# ════════════════════════════════════════════════════
# v1.8 추가 2: ConsumerType (금융소비자 분류) + 분류 원칙
# ════════════════════════════════════════════════════

inv:ConsumerType a owl:Class ;
  rdfs:label "금융소비자유형"@ko ;
  rdfs:label "ConsumerType"@en ;
  rdfs:comment "금융소비자보호법상 금융소비자 분류. 전문/일반으로 구분되며 적용되는 적합성·설명의무 강도가 다름."@ko .

inv:ConsumerType_Professional a owl:NamedIndividual, inv:ConsumerType ;
  rdfs:label "전문금융소비자"@ko ;
  rdfs:label "Professional Financial Consumer"@en ;
  rdfs:comment "금소법상 전문금융소비자. 적합성원칙·설명의무 면제 대상(다만 자본시장법상 형식적 확인 의무는 유지). 펀드·법인·국가·금융기관 등이 해당."@ko .

inv:ConsumerType_General a owl:NamedIndividual, inv:ConsumerType ;
  rdfs:label "일반금융소비자"@ko ;
  rdfs:label "General Financial Consumer"@en ;
  rdfs:comment "금소법상 일반금융소비자. 적합성원칙·설명의무 등 보호 규정 전면 적용. 일반 개인 등이 해당."@ko .

# Counterparty - ConsumerType 매핑 속성
inv:hasConsumerType a owl:ObjectProperty ;
  rdfs:label "금융소비자유형"@ko ;
  rdfs:domain inv:Counterparty ;
  rdfs:range inv:ConsumerType ;
  rdfs:comment "거래상대방이 어떤 금융소비자 유형에 해당하는지. 분류는 ClassificationPrinciple에 따라 결정."@ko .

# 분류 원칙 메타 클래스
inv:ClassificationPrinciple a owl:Class ;
  rdfs:label "분류원칙"@ko ;
  rdfs:label "ClassificationPrinciple"@en ;
  rdfs:comment "온톨로지의 분류·매핑이 따르는 명시적 원칙. 도메인 전문가에게 자명하나 4B급 LLM은 자동 적용 못함. Gruber의 'explicit specification' 깊이 — 결과뿐 아니라 원칙 자체도 명시화 대상."@ko .

# 분류 원칙 인스턴스
inv:Principle_FundAsProfessional a owl:NamedIndividual, inv:ClassificationPrinciple ;
  rdfs:label "펀드는 전문금융소비자"@ko ;
  rdfs:comment "거래상대방이 펀드(집합투자기구)인 경우 전 케이스 전문금융소비자에 해당. 자본시장법 제249조의2 등 근거. LP출자 시 거래상대방의 대부분이 펀드이므로 본 원칙 광범위 적용. 본 원칙은 예외 없이 적용됨."@ko ;
  inv:appliesTo inv:RecipientFund ;
  inv:resultsIn inv:ConsumerType_Professional .

inv:Principle_CorporationAsProfessional a owl:NamedIndividual, inv:ClassificationPrinciple ;
  rdfs:label "법인은 일반적으로 전문금융소비자 (예외 존재, 사용자 판단 필요)"@ko ;
  rdfs:comment "거래상대방이 법인인 경우 일반적으로 전문금융소비자에 해당하나 예외가 존재함. 자본시장법 시행령 제10조 등에 따라 소규모 법인, 일반금융소비자 전환 신청 법인, 외국 법인 등은 별도 검토 필요. 본 원칙은 일반 원칙일 뿐이며 개별 케이스의 최종 분류는 거래 시점에 사용자(담당자)가 케이스별로 판단하여야 함. 온톨로지·LLM은 분류를 자동으로 결정하지 않고 판단의 근거를 제시하는 역할에 한정됨."@ko ;
  inv:appliesTo inv:PortfolioCompany ;
  inv:resultsIn inv:ConsumerType_Professional .

inv:Principle_GPAsProfessional a owl:NamedIndividual, inv:ClassificationPrinciple ;
  rdfs:label "GP는 전문금융소비자"@ko ;
  rdfs:comment "거래상대방이 GP(업무집행조합원·자산운용사)인 경우 전문금융소비자에 해당. 개인이 GP 역할을 수행하는 경우는 실무상 사실상 부재하며, 자본시장법·여전법상 GP 자격 요건이 사실상 전문금융소비자 자격을 전제로 함(향후 명시 근거 보강 필요). 실무 경험상 일반금융소비자 GP는 관찰된 바 없음."@ko ;
  inv:appliesTo inv:GP ;
  inv:resultsIn inv:ConsumerType_Professional .

inv:Principle_LPDefaultRWAClass a owl:NamedIndividual, inv:ClassificationPrinciple ;
  rdfs:label "LP출자는 무조건 집합투자증권 익스포져 (RWA 자산분류)"@ko ;
  rdfs:comment "LP출자한 펀드의 RWA 산정 시 펀드 형태(신기술사업투자조합·벤처투자조합·사모투자신탁·투자회사·사모집합투자기구·투자합자조합 등) 무관하게 모두 '집합투자증권 익스포져'로 분류. LP출자는 본질적으로 펀드를 통해 최종 투자 대상에 자금을 모아(집합) 간접 투자하는 형식이므로, 펀드 형태와 관계없이 본 분류가 예외 없이 적용됨. 별표 3 제2장 제3절 44.가 근거. 본 원칙은 예외 없이 적용됨."@ko ;
  inv:appliesTo inv:RecipientFund ;
  inv:resultsIn inv:BSER_App3_Asset_CIS .

inv:Principle_LPAlternativeClassification a owl:NamedIndividual, inv:ClassificationPrinciple ;
  rdfs:label "LP출자의 대체투자 분류는 최종 투자 대상에 따른 조건부 분류"@ko ;
  rdfs:comment "LP출자의 대체투자 해당 여부는 펀드 형태가 아닌 펀드의 최종 투자 대상에 따라 조건부로 결정됨. 'LP출자는 대체투자다' 또는 'LP출자는 대체투자가 아니다'라는 단방향 단정은 부정확. (a) 펀드의 최종 투자 대상이 투자등급 이상 기업 또는 상장사인 경우 대체투자에 해당하지 않음. (b) 펀드의 최종 투자 대상이 비상장사·부동산·SOC·선박·항공기 등인 경우 대체투자에 해당함. 즉 LP출자라는 형식이 아닌 실질 투자 대상 기준의 위계적·조건부 분류 원칙. 여전사 대체투자 리스크관리 모범규준 별표 1 근거."@ko ;
  inv:appliesTo inv:RecipientFund ;
  inv:relatedConcept inv:Concept_AlternativeInvestmentClassification .

# 분류 원칙 속성들
inv:appliesTo a owl:ObjectProperty ;
  rdfs:label "적용대상"@ko ;
  rdfs:domain inv:ClassificationPrinciple ;
  rdfs:range owl:Thing ;
  rdfs:comment "이 분류 원칙이 적용되는 클래스 또는 개념"@ko ;
  rdfs:comment "범용 관계라 owl:Thing 사용"@ko .

inv:resultsIn a owl:ObjectProperty ;
  rdfs:label "결과"@ko ;
  rdfs:domain inv:ClassificationPrinciple ;
  rdfs:range owl:Thing ;
  rdfs:comment "이 원칙 적용 시 도출되는 분류 결과"@ko ;
  rdfs:comment "범용 관계라 owl:Thing 사용"@ko .

inv:relatedConcept a owl:ObjectProperty ;
  rdfs:label "관련개념"@ko ;
  rdfs:domain inv:ClassificationPrinciple ;
  rdfs:range inv:RegulatoryConcept .

# ════════════════════════════════════════════════════
# v1.8 추가 3: Demo 인스턴스에 다중 type + ConsumerType 매핑
# ════════════════════════════════════════════════════
# rdflib 기본 SPARQL은 추론 안 함. 명시 type 박아야 SPARQL이 즉시 찾음.

# GP 인스턴스들
inv:Demo_GP_ABC a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_GP ;
  inv:hasConsumerType inv:ConsumerType_Professional .
inv:Demo_GP_vvip a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_GP ;
  inv:hasConsumerType inv:ConsumerType_Professional .
inv:Demo_GP_aespa a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_GP ;
  inv:hasConsumerType inv:ConsumerType_Professional .
inv:Demo_GP_itzy a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_GP ;
  inv:hasConsumerType inv:ConsumerType_Professional .

# RecipientFund 인스턴스들
inv:Demo_Fund_ABC a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_LP ;
  inv:hasConsumerType inv:ConsumerType_Professional .
inv:Demo_Fund_1q2w a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_LP ;
  inv:hasConsumerType inv:ConsumerType_Professional .
inv:Demo_Fund_alldayproject a inv:Counterparty, inv:Customer ;
  inv:hasCounterpartyRole inv:Role_LP ;
  inv:hasConsumerType inv:ConsumerType_Professional .
