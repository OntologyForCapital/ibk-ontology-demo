# ════════════════════════════════════════════════════
# v0.9 보강 (Tier 1 작업 반영)
# ════════════════════════════════════════════════════

# === A. 신규 부모 클래스 4개 ===
inv:RegulatoryAttribute a owl:Class ;
  rdfs:label "규제분류속성"@ko ;
  rdfs:label "RegulatoryAttribute"@en ;
  rdfs:comment "외부 규제(법률·감독규정·모범규준)에 의해 정의되는 분류 속성. 위험가중치·자산건전성·소비자유형·계열집단·국가 등 규제 적용 시 참조하는 분류 체계의 상위 개념."@ko ;
  inv:category "DomainStructure" .

inv:DomainCode a owl:Class ;
  rdfs:label "도메인코드"@ko ;
  rdfs:label "DomainCode"@en ;
  rdfs:comment "투자금융 도메인 내부에서 사용되는 분류 코드값. 담보종류·보증자격·상품유형·트렌치·운용역할·자금원 등 업무 분류에 쓰이는 코드 집합의 상위 개념."@ko ;
  inv:category "DomainStructure" .

inv:OrganizationalUnit a owl:Class ;
  rdfs:label "조직단위"@ko ;
  rdfs:label "OrganizationalUnit"@en ;
  rdfs:comment "조직적·결재 권한 단위를 표현하는 클래스의 상위 개념."@ko ;
  inv:category "DomainStructure" .

inv:SystemEntity a owl:Class ;
  rdfs:label "시스템엔티티"@ko ;
  rdfs:label "SystemEntity"@en ;
  rdfs:comment "사내·외부 시스템과 그 구성요소(필드·외부 데이터 출처 등)를 표현하는 클래스의 상위 개념."@ko ;
  inv:category "DomainStructure" .

# === B. 클래스 위계 보강 (루트 21개 중 17개를 의미축 부모로 묶음) ===
inv:AlternativeAssetClass rdfs:subClassOf inv:RegulatoryAttribute .
inv:AssetSoundnessGrade rdfs:subClassOf inv:RegulatoryAttribute .
inv:BaselAssetClass rdfs:subClassOf inv:RegulatoryAttribute .
inv:ConsumerType rdfs:subClassOf inv:RegulatoryAttribute .
inv:LimitType rdfs:subClassOf inv:RegulatoryAttribute .
inv:Conglomerate rdfs:subClassOf inv:RegulatoryAttribute .
inv:Country rdfs:subClassOf inv:RegulatoryAttribute .
inv:CollateralType rdfs:subClassOf inv:DomainCode .
inv:GuaranteeQualification rdfs:subClassOf inv:DomainCode .
inv:ProductCode rdfs:subClassOf inv:DomainCode .
inv:Tranche rdfs:subClassOf inv:DomainCode .
inv:ManagementRole rdfs:subClassOf inv:DomainCode .
inv:FundingSource rdfs:subClassOf inv:DomainCode .
inv:ApprovalLevel rdfs:subClassOf inv:OrganizationalUnit .
inv:Field rdfs:subClassOf inv:SystemEntity .
inv:ExternalSystem rdfs:subClassOf inv:SystemEntity .

# === C. Obligation 클래스 10개 라벨·주석 추가 ===
inv:Obligation_Definition
  rdfs:label "정의"@ko ;
  rdfs:comment "법률 용어의 정의 조항"@ko .

inv:Obligation_Compliance
  rdfs:label "준수의무"@ko ;
  rdfs:comment "'~하여야 한다'식 적극 의무. 한국 금융법의 가장 흔한 패턴"@ko .

inv:Obligation_Prohibition
  rdfs:label "금지"@ko ;
  rdfs:comment "'~할 수 없다'식 금지·제한"@ko .

inv:Obligation_Approval
  rdfs:label "승인"@ko ;
  rdfs:comment "사전 승인·인가·신고 의무"@ko .

inv:Obligation_Reporting
  rdfs:label "보고"@ko ;
  rdfs:comment "정기·비정기 보고·통지·공시·통보 의무"@ko .

inv:Obligation_LimitRule
  rdfs:label "한도"@ko ;
  rdfs:comment "한도·비율 규정 (RWA·자기자본·동일차주 한도 등)"@ko .

inv:Obligation_Management
  rdfs:label "관리"@ko ;
  rdfs:comment "운영·관리·수행 절차"@ko .

inv:Obligation_Recordkeeping
  rdfs:label "기록"@ko ;
  rdfs:comment "기록·보존·등록 의무"@ko .

inv:Obligation_DisclosureObligation
  rdfs:label "설명·고지"@ko ;
  rdfs:comment "상대방에 대한 설명·고지 의무"@ko .

inv:Obligation_General
  rdfs:label "일반"@ko ;
  rdfs:comment "위 어디에도 명확히 분류되지 않는 일반 조항"@ko .

# === D. LP출자 미적용 클래스 (향후 다른 상품 확장 시 활용) ===
inv:CollateralType rdfs:comment "LP출자(지분투자)에서는 사용하지 않음. 향후 여신·대출 상품으로 확장 시 활용 가능."@ko .
inv:CreditEnhancement rdfs:comment "LP출자(지분투자)에서는 사용하지 않음. 향후 여신·대출 상품으로 확장 시 활용 가능."@ko .
inv:GuaranteeQualification rdfs:comment "LP출자(지분투자)에서는 사용하지 않음. 향후 여신·대출 상품으로 확장 시 활용 가능."@ko .

# === E. 신규 인스턴스 추가 ===
# E-1. FundingSource 인스턴스 (LP출자는 무조건 고유계정)
inv:ProprietaryAccount a owl:NamedIndividual, inv:FundingSource ;
  rdfs:label "고유계정"@ko ;
  rdfs:label "Proprietary Account"@en ;
  rdfs:comment "회사의 고유 자산으로 출자. 본 회사 LP출자의 유일한 자금원."@ko .

# E-2. ManagementRole 인스턴스 (운용 역할)
inv:Role_GP a owl:NamedIndividual, inv:ManagementRole ;
  rdfs:label "GP"@ko ;
  rdfs:label "General Partner"@en ;
  rdfs:comment "업무집행조합원 또는 펀드 운용사. 펀드 의사결정과 운용 책임."@ko .

inv:Role_CoGP a owl:NamedIndividual, inv:ManagementRole ;
  rdfs:label "Co-GP"@ko ;
  rdfs:label "Co-General Partner"@en ;
  rdfs:comment "공동 GP. GP와 함께 운용 책임을 분담."@ko .

inv:Role_LP a owl:NamedIndividual, inv:ManagementRole ;
  rdfs:label "LP"@ko ;
  rdfs:label "Limited Partner"@en ;
  rdfs:comment "유한책임사원/조합원. 출자만 하고 운용에 참여하지 않음. 본 회사가 LP출자 시 자기 역할."@ko .

# E-3. ProductCode 인스턴스 (5개 펀드 형태) + 근거 법률
# 새 속성: isDefinedIn (펀드 형태가 정의되는 법률 조항)
inv:isDefinedIn a owl:ObjectProperty ;
  rdfs:label "정의근거"@ko ;
  rdfs:domain inv:ProductCode ;
  rdfs:range inv:RegulatoryClause ;
  rdfs:comment "펀드 형태 또는 상품이 법률·규정에 의해 정의되는 근거 조항."@ko ;
  inv:category "RegulatoryApplication" .

inv:Product_NewTechFund a owl:NamedIndividual, inv:ProductCode ;
  rdfs:label "신기술사업투자조합"@ko ;
  rdfs:label "New Technology Business Investment Partnership"@en ;
  rdfs:comment "여신전문금융업법(SFA) 또는 벤처투자법(VIA) 근거. 신기술사업투자에 특화."@ko ;
  inv:isDefinedIn inv:SFA .

inv:Product_PEF a owl:NamedIndividual, inv:ProductCode ;
  rdfs:label "사모투자합자회사 (PEF)"@ko ;
  rdfs:label "Private Equity Fund"@en ;
  rdfs:comment "자본시장법 제249조 시리즈에 따른 경영참여형 사모집합투자기구. 투자합자회사 형태."@ko ;
  inv:isDefinedIn inv:CMFA .

inv:Product_InvestmentTrust a owl:NamedIndividual, inv:ProductCode ;
  rdfs:label "투자신탁"@ko ;
  rdfs:label "Investment Trust"@en ;
  rdfs:comment "자본시장법 제9조 제18항 제1호에 따른 신탁형 집합투자기구. 수익증권 발행."@ko ;
  inv:isDefinedIn inv:CMFA_Art9 .

inv:Product_LimitedPartnership a owl:NamedIndividual, inv:ProductCode ;
  rdfs:label "투자합자조합"@ko ;
  rdfs:label "Investment Limited Partnership"@en ;
  rdfs:comment "자본시장법 제218조에 따른 조합형 집합투자기구. PEF의 주된 법적 형태."@ko ;
  inv:isDefinedIn inv:CMFA_Art218 .

inv:Product_VentureFund a owl:NamedIndividual, inv:ProductCode ;
  rdfs:label "벤처투자조합"@ko ;
  rdfs:label "Venture Investment Association"@en ;
  rdfs:comment "벤처투자 촉진에 관한 법률에 따른 벤처투자조합. 벤처기업 투자에 특화."@ko ;
  inv:isDefinedIn inv:VIA .

# E-4. Tranche 인스턴스 (투자 순위)
inv:Tranche_Senior a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "선순위"@ko ;
  rdfs:label "Senior"@en ;
  rdfs:comment "최우선 변제 순위. 채권 형태 투자에 일반적."@ko .

inv:Tranche_Mezzanine a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "중순위"@ko ;
  rdfs:label "Mezzanine"@en ;
  rdfs:comment "선순위와 후순위 사이의 변제 순위."@ko .

inv:Tranche_Equity a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "Equity"@ko ;
  rdfs:label "Equity"@en ;
  rdfs:comment "지분 투자. LP출자의 기본 트렌치."@ko .

inv:Tranche_SeniorEquity a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "선순위 Equity"@ko ;
  rdfs:label "Senior Equity"@en ;
  rdfs:comment "Equity 내 선순위. 우선주 등."@ko .

inv:Tranche_MidEquity a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "중순위 Equity"@ko ;
  rdfs:label "Mid Equity"@en ;
  rdfs:comment "Equity 내 중순위."@ko .

inv:Tranche_JuniorEquity a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "후순위 Equity"@ko ;
  rdfs:label "Junior Equity"@en ;
  rdfs:comment "Equity 내 후순위. 보통주 등."@ko .

inv:Tranche_Mixed a owl:NamedIndividual, inv:Tranche ;
  rdfs:label "복합"@ko ;
  rdfs:label "Mixed"@en ;
  rdfs:comment "여러 트렌치가 혼합된 형태."@ko .

# === F. 카디널리티 제약 (Tier1-C 검토 반영) ===
# 적용 8건 / 미적용 2건 (Investment.managedByGP, BusinessProcess.followsStep)

# F-1. Functional Property (값이 정확히 1개)
inv:hasCommitmentLimit a owl:FunctionalProperty .
inv:hasExecutionDate a owl:FunctionalProperty .

# F-2. minCardinality 1 (최소 1개 필수)
# 투자건은 반드시 직접 송금 대상(RecipientFund)을 가져야 함
inv:Investment rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty inv:isDirectRecipient ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# 고객은 관할 국가가 명시되어야 함
inv:Customer rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty inv:hasJurisdiction ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# 법인 고객은 대표자가 명시되어야 함 (대표자는 자연인 또는 법인)
inv:CorporateEntity rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty inv:hasRepresentative ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# 출자대상펀드는 운용사(GP)가 명시되어야 함
inv:RecipientFund rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty inv:managedByGP ;
  owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# === G. FundOrPartnership 구조 재구성 (김대환님 도메인 인사이트) ===
# 변경 사유: LP출자에서 펀드/조합도 고객 분류에 속함. PortfolioCompany와 함께
# Customer의 직접 하위로 재구성하여 도메인 관점 명확화.
inv:FundOrPartnership rdfs:subClassOf inv:Customer .

# RecipientFund의 다중 상속(Customer + FundOrPartnership)을 단일 상속으로 정리
# (FundOrPartnership이 이미 Customer의 하위이므로 transitive로 Customer 상속됨)
# 기존 다중 상속은 그대로 두어도 OWL 추론에서 중복 처리되어 문제 없음.

# === H. hasRepresentative range 확장 (대표자가 법인일 수도 있음) ===
# 기존: range = Actor (자연인 가정)
# 신규: range = Actor 또는 CorporateEntity (법인 대표 가능)
# 단일 range 제약을 풀고 union range를 추가
inv:hasRepresentative rdfs:range [
  a owl:Class ;
  owl:unionOf ( inv:Actor inv:CorporateEntity )
] .


# ════════════════════════════════════════════════════
# v1.0 추가: 채번체계·분기·상태 추적
# ════════════════════════════════════════════════════

# === 1. ProcessRecord (단계 채번 처리건) ===
inv:ProcessRecord a owl:Class ;
  rdfs:label "단계처리건"@ko ;
  rdfs:label "ProcessRecord"@en ;
  rdfs:comment "각 업무 단계에서 채번되어 생성되는 구체 처리 단위. ConsultationID, ScreeningID 등 사내 채번 식별자가 인스턴스 ID로 매핑됨. 이전 단계로부터 hasNextStep으로 연결되며, 분기(1:N) 가능."@ko .

inv:Consultation a owl:Class ;
  rdfs:subClassOf inv:ProcessRecord ;
  rdfs:label "상담건"@ko ;
  rdfs:label "Consultation"@en ;
  rdfs:comment "Investment 1건이 채번되는 시점. 거래상대방·초기 조건이 식별됨. ConsultationID로 채번."@ko .

inv:Screening a owl:Class ;
  rdfs:subClassOf inv:ProcessRecord ;
  rdfs:label "사전협의건"@ko ;
  rdfs:label "Screening"@en ;
  rdfs:comment "리스크부서·감리부서 협의 단계. 한도·바젤분류·자산건전성 검토. ScreeningID로 채번. 한 상담이 N개 사전협의로 분기 가능."@ko .

inv:Review a owl:Class ;
  rdfs:subClassOf inv:ProcessRecord ;
  rdfs:label "예비검토건"@ko ;
  rdfs:label "Review"@en ;
  rdfs:comment "사전협의 결과 기반 예비 검토. ReviewID로 채번."@ko .

inv:WorkingReview a owl:Class ;
  rdfs:subClassOf inv:ProcessRecord ;
  rdfs:label "실무협의건"@ko ;
  rdfs:label "WorkingReview"@en ;
  rdfs:comment "다부서 책임자 실무 협의회. WorkingReviewID로 채번."@ko .

inv:Proposal a owl:Class ;
  rdfs:subClassOf inv:ProcessRecord ;
  rdfs:label "품의건"@ko ;
  rdfs:label "Proposal"@en ;
  rdfs:comment "정식 투자 품의. 본부장·심사위원회 결재. ProposalID로 채번."@ko .

# === 2. 채번 연결 속성 (1:N 분기) ===
inv:hasNextStep a owl:ObjectProperty ;
  rdfs:label "다음단계연동"@ko ;
  rdfs:label "hasNextStep"@en ;
  rdfs:domain inv:ProcessRecord ;
  rdfs:range inv:ProcessRecord ;
  rdfs:comment "사내 채번 체계의 단계 간 연동. 카디널리티 제약 없음 - 1개면 직선 흐름, N개면 분기 (예: 우선주·전환사채로 분리)."@ko ;
  inv:category "ProcessFlow" .

inv:precededBy a owl:ObjectProperty ;
  rdfs:label "이전단계연동"@ko ;
  rdfs:label "precededBy"@en ;
  rdfs:domain inv:ProcessRecord ;
  rdfs:range inv:ProcessRecord ;
  owl:inverseOf inv:hasNextStep ;
  inv:category "ProcessFlow" .

# === 3. 진행 상태 (State) ===
inv:State a owl:Class ;
  rdfs:subClassOf inv:DomainCode ;
  rdfs:label "진행상태"@ko ;
  rdfs:label "State"@en ;
  rdfs:comment "Investment 1건의 현재 진행 상태. Gemma가 \"이 건 어디까지 갔어?\" 같은 질의에 답변 가능."@ko .

inv:hasState a owl:ObjectProperty ;
  rdfs:label "현재진행상태"@ko ;
  rdfs:label "hasState"@en ;
  rdfs:domain inv:Investment ;
  rdfs:range inv:State ;
  inv:category "ProcessFlow" .

inv:State_Consultation a owl:NamedIndividual, inv:State ;
  rdfs:label "상담중"@ko ;
  rdfs:comment "Consultation 채번 후 사전협의 미진입"@ko .

inv:State_Screening a owl:NamedIndividual, inv:State ;
  rdfs:label "사전협의진행중"@ko ;
  rdfs:comment "Screening 채번 후 예비검토 미진입"@ko .

inv:State_Review a owl:NamedIndividual, inv:State ;
  rdfs:label "예비검토중"@ko ;
  rdfs:comment "Review 채번 후 실무협의 미진입"@ko .

inv:State_WorkingReview a owl:NamedIndividual, inv:State ;
  rdfs:label "실무협의진행"@ko ;
  rdfs:comment "WorkingReview 채번 후 품의 미진입"@ko .

inv:State_Proposal a owl:NamedIndividual, inv:State ;
  rdfs:label "품의진행"@ko ;
  rdfs:comment "Proposal 채번 후 약정 미체결"@ko .

inv:State_Commitment a owl:NamedIndividual, inv:State ;
  rdfs:label "약정체결"@ko ;
  rdfs:comment "Commitment 체결 후 개별품의 진입"@ko .

inv:State_Drawdown a owl:NamedIndividual, inv:State ;
  rdfs:label "실행진행"@ko ;
  rdfs:comment "DrawdownExecution 1건 이상 진행 중"@ko .

inv:State_PostManagement a owl:NamedIndividual, inv:State ;
  rdfs:label "사후관리진행"@ko ;
  rdfs:comment "최종 실행 후 사후관리 단계"@ko .

inv:State_Closed a owl:NamedIndividual, inv:State ;
  rdfs:label "정상종결"@ko ;
  rdfs:comment "투자 회수 완료"@ko .

inv:State_Rejected a owl:NamedIndividual, inv:State ;
  rdfs:label "심사부결"@ko ;
  rdfs:comment "단계 중 심사 부결로 종료"@ko .

inv:State_Withdrawn a owl:NamedIndividual, inv:State ;
  rdfs:label "거래상대방철회"@ko ;
  rdfs:comment "거래상대방 자체 철회로 종료"@ko .

# === 4. Investment 정의 명확화 ===
inv:Investment
  rdfs:comment "투자 검토의 1건. 상담 단계에서 채번되며 거래상대방·초기 조건이 식별되는 시점에 생성됨. 사전협의 이후 분기될 수 있으며, 이 경우 1개 Investment가 N개의 후속 단계 처리건(ProcessRecord)을 가짐. Investment 자체는 분기되어도 1개로 유지되며, 각 가지(branch)는 하위 단계 인스턴스로 표현됨. inv:hasState로 현재 진행 상태 추적, inv:hasOrigin으로 채번된 상담건과 연결."@ko .

inv:hasOrigin a owl:ObjectProperty ;
  rdfs:label "최초상담"@ko ;
  rdfs:label "hasOrigin"@en ;
  rdfs:domain inv:Investment ;
  rdfs:range inv:Consultation ;
  rdfs:comment "Investment를 시작시킨 최초 상담건. 분기 추적의 기준점."@ko ;
  inv:category "ProcessFlow" .

# ════════════════════════════════════════════════════
# === 5. 데모용 가상 인스턴스 ===
# 시나리오: 거래상대방 ABC와 10억 LP출자 상담
#          → 우선주 5억(사전협의1) + 전환사채 5억(사전협의2)로 분기
#          → 사전협의1만 약정·실행 진행, 사전협의2는 예비검토 단계
# (실제 운영 단계에선 사내 채번 시스템에서 자동 생성됨)
# ════════════════════════════════════════════════════

# --- 거래상대방 (가상) ---
inv:Demo_GP_ABC a owl:NamedIndividual, inv:GP ;
  rdfs:label "ABC 자산운용 (가상)"@ko ;
  rdfs:comment "데모 시연용 가상 GP."@ko .

# --- Investment 1건 (상담 단위) ---
inv:Demo_Investment_001 a owl:NamedIndividual, inv:Investment ;
  rdfs:label "ABC PEF 출자 검토 (가상)"@ko ;
  rdfs:comment "ABC 자산운용 GP의 신규 PEF에 대한 LP출자 검토 1건. 분기 후 진행 상태 분리됨."@ko ;
  inv:hasOrigin inv:Demo_Consultation_C2026_0042 ;
  inv:hasState inv:State_Drawdown ;     # 가지 1이 가장 진행됨 → Drawdown 상태
  inv:managedByGP inv:Demo_GP_ABC ;
  inv:hasProductType inv:Product_PEF .

# --- 단계 1: 상담 (Consultation) ---
inv:Demo_Consultation_C2026_0042 a owl:NamedIndividual, inv:Consultation ;
  rdfs:label "C-2026-0042 상담건 (가상)"@ko ;
  rdfs:comment "ABC 자산운용 GP, 신규 PEF 출자 검토 상담. 총 10억 검토."@ko ;
  inv:hasNextStep inv:Demo_Screening_S2026_0101 ,
                   inv:Demo_Screening_S2026_0102 .   # ← 분기

# --- 단계 2 (분기): 사전협의 (Screening) ---
inv:Demo_Screening_S2026_0101 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "S-2026-0101 사전협의 (우선주 5억)"@ko ;
  rdfs:comment "ABC PEF 우선주 형태 5억 사전협의. 약정·실행까지 진행."@ko ;
  inv:precededBy inv:Demo_Consultation_C2026_0042 ;
  inv:hasNextStep inv:Demo_Review_R2026_0205 ;
  inv:hasTranche inv:Tranche_SeniorEquity .

inv:Demo_Screening_S2026_0102 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "S-2026-0102 사전협의 (전환사채 5억)"@ko ;
  rdfs:comment "ABC PEF 전환사채 형태 5억 사전협의. 예비검토 단계까지만."@ko ;
  inv:precededBy inv:Demo_Consultation_C2026_0042 ;
  inv:hasNextStep inv:Demo_Review_R2026_0206 ;
  inv:hasTranche inv:Tranche_Mezzanine .

# --- 가지 1 후속 (S-2026-0101 → 약정·실행까지 진행) ---
inv:Demo_Review_R2026_0205 a owl:NamedIndividual, inv:Review ;
  rdfs:label "R-2026-0205 예비검토 (우선주)"@ko ;
  inv:precededBy inv:Demo_Screening_S2026_0101 ;
  inv:hasNextStep inv:Demo_WorkingReview_W2026_0098 .

inv:Demo_WorkingReview_W2026_0098 a owl:NamedIndividual, inv:WorkingReview ;
  rdfs:label "W-2026-0098 실무협의회 (우선주)"@ko ;
  inv:precededBy inv:Demo_Review_R2026_0205 ;
  inv:hasNextStep inv:Demo_Proposal_P2026_0067 .

inv:Demo_Proposal_P2026_0067 a owl:NamedIndividual, inv:Proposal ;
  rdfs:label "P-2026-0067 품의 (우선주)"@ko ;
  inv:precededBy inv:Demo_WorkingReview_W2026_0098 ;
  inv:hasNextStep inv:Demo_Commitment_A2026_0034 .

inv:Demo_Commitment_A2026_0034 a owl:NamedIndividual, inv:Commitment ;
  rdfs:label "A-2026-0034 약정 (우선주 5억)"@ko ;
  inv:precededBy inv:Demo_Proposal_P2026_0067 ;
  inv:hasCommitmentLimit "500000000"^^xsd:decimal ;
  inv:hasIndividualApproval inv:Demo_Drawdown_D2026_0089 .

inv:Demo_Drawdown_D2026_0089 a owl:NamedIndividual, inv:DrawdownExecution ;
  rdfs:label "D-2026-0089 개별품의 1차 (3억 인출)"@ko ;
  inv:hasExecutionDate "2026-04-15"^^xsd:date .

# --- 가지 2 후속 (S-2026-0102 → 예비검토까지만, 이후 미진행) ---
inv:Demo_Review_R2026_0206 a owl:NamedIndividual, inv:Review ;
  rdfs:label "R-2026-0206 예비검토 (전환사채)"@ko ;
  rdfs:comment "전환사채 가지는 예비검토 단계에서 정체 (실무협의회 미상정)."@ko ;
  inv:precededBy inv:Demo_Screening_S2026_0102 .


# ════════════════════════════════════════════════════
# v1.1 추가: ActorProcess 양방향 표현 (inverseOf)
# ════════════════════════════════════════════════════

inv:performedBy a owl:ObjectProperty ;
  rdfs:label "수행주체"@ko ;
  rdfs:label "performedBy"@en ;
  rdfs:domain inv:BusinessProcess ;
  rdfs:range inv:Actor ;
  owl:inverseOf inv:participatesIn ;
  rdfs:comment "단계의 수행 주체. inv:participatesIn의 역방향. BusinessProcess 관점에서 'performedBy ?actor' 쿼리 가능."@ko ;
  inv:category "ActorProcess" .

inv:reviewedBy a owl:ObjectProperty ;
  rdfs:label "검토주체"@ko ;
  rdfs:label "reviewedBy"@en ;
  rdfs:domain inv:BusinessProcess ;
  rdfs:range inv:Actor ;
  owl:inverseOf inv:reviewsAt ;
  rdfs:comment "단계의 검토 주체. inv:reviewsAt의 역방향."@ko ;
  inv:category "ActorProcess" .

inv:approvedBy a owl:ObjectProperty ;
  rdfs:label "승인주체"@ko ;
  rdfs:label "approvedBy"@en ;
  rdfs:domain inv:BusinessProcess ;
  rdfs:range inv:Actor ;
  owl:inverseOf inv:approvesAt ;
  rdfs:comment "단계의 승인(결재) 주체. inv:approvesAt의 역방향."@ko ;
  inv:category "ActorProcess" .


# ════════════════════════════════════════════════════
# v1.2 추가: RegulatoryConcept 중간 계층 (3층 구조)
# ════════════════════════════════════════════════════
# 도입 배경: v3 시스템 시연 (Q6) 결과 단순 키워드 매칭의 의미 왜곡 발견
# 해결 접근: 업무 절차의 검토 의도를 명시적 개념으로 모델링

# === 1. RegulatoryConcept 클래스 신설 ===
inv:RegulatoryConcept a owl:Class ;
  rdfs:label "규제검토개념"@ko ;
  rdfs:label "RegulatoryConcept"@en ;
  rdfs:comment "업무 단계에서 검토해야 하는 의무 개념. 법령 자체가 아닌 업무 절차상의 검토 대상(예: 신용공여한도, RWA, 대체투자분류 등). 한 개념은 여러 법령에 의해 정의될 수 있으며(groundedIn), 한 단계는 여러 개념을 검토(checks)함."@ko .

# === 2. 3층 연결 속성 ===
inv:checks a owl:ObjectProperty ;
  rdfs:label "검토대상"@ko ;
  rdfs:label "checks"@en ;
  rdfs:domain inv:BusinessProcess ;
  rdfs:range inv:RegulatoryConcept ;
  rdfs:comment "업무 단계가 검토하는 규제 개념. 한 단계는 여러 개념을 검토 가능 (1:N)."@ko ;
  inv:category "RegulatoryApplication" .

inv:groundedIn a owl:ObjectProperty ;
  rdfs:label "근거법령"@ko ;
  rdfs:label "groundedIn"@en ;
  rdfs:domain inv:RegulatoryConcept ;
  rdfs:range inv:RegulatoryClause ;
  rdfs:comment "규제 개념의 근거가 되는 법령 조항. 한 개념은 여러 법령에 의해 정의 가능 (1:N)."@ko ;
  inv:category "RegulatoryApplication" .

inv:isCheckedBy a owl:ObjectProperty ;
  rdfs:label "검토주체단계"@ko ;
  rdfs:domain inv:RegulatoryConcept ;
  rdfs:range inv:BusinessProcess ;
  owl:inverseOf inv:checks ;
  inv:category "RegulatoryApplication" .

# === 3. RegulatoryConcept 인스턴스 (12개) ===
inv:Concept_CustomerIdentification a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "고객확인"@ko ;
  rdfs:comment "거래상대방의 신원·실소유자·자금원천 확인. 자금세탁 방지 의무."@ko ;
  inv:isCheckedBy inv:CustomerRegistration
 ;
  inv:groundedIn inv:AMLA_Art5_2 ;
  inv:groundedIn inv:AMLA_Art4 .

inv:Concept_ConsumerClassification a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "소비자분류"@ko ;
  rdfs:comment "거래상대방을 일반금융소비자/전문금융소비자로 분류. 상이한 보호 의무 적용."@ko ;
  inv:isCheckedBy inv:CustomerRegistration
 ;
  inv:groundedIn inv:FCPA_Art2 .

inv:Concept_SuitabilityCheck a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "적합성확인"@ko ;
  rdfs:comment "투자상담 시 적합성원칙 확인 절차. 다만 LP출자 거래상대방은 대부분 펀드·법인으로 전문금융소비자에 해당하여 일반금융소비자 대상 적합성원칙은 적용되지 않는 경우가 많음. 그럼에도 자본시장법상 확인 의무 이행 자체가 절차의 목적이며, 전산상 별도 모듈은 없이 형식적으로 수행됨."@ko ;
  inv:isCheckedBy inv:InvestmentConsultation
 ;
  inv:groundedIn inv:FCPA_Art17 .

inv:Concept_ExplanationDuty a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "설명의무"@ko ;
  rdfs:comment "LP출자에서 본 회사의 위치는 운용사·펀드의 고객(LP)이지만, 회사 내부 전산 체계는 LP출자금을 \"판매\"하는 형태로 처리되어 설명의무 적용 대상으로 분류됨. 실무상 사실상 형식적 절차이나 자본시장법상 확인 차원에서 수행."@ko ;
  inv:isCheckedBy inv:InvestmentConsultation
 ;
  inv:groundedIn inv:FCPA_Art19 .

inv:Concept_TotalExposureLimit a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "신용공여한도"@ko ;
  rdfs:comment "동일차주·대주주·계열집단 등에 대한 신용공여 한도. 자기자본 대비 비율로 산정. 사전심사 단계의 핵심 검토 항목."@ko ;
  inv:isCheckedBy inv:PreliminaryScreening
 ;
  inv:groundedIn inv:BA_Art35 ;
  inv:groundedIn inv:SFA_Art49_2 .

inv:Concept_RWA_Calculation a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "위험가중자산산정"@ko ;
  rdfs:comment "자산별 위험가중치를 적용한 위험가중자산(RWA) 산정. 자기자본비율 산출의 분모. 표준방법(SA) 기준 적용."@ko ;
  inv:isCheckedBy inv:PreliminaryScreening
 ;
  inv:groundedIn inv:BSER_Art17 ;
  inv:groundedIn inv:BSER_App3_Ch1_p1 ;
  inv:groundedIn inv:BSER_App3_Ch2_Sec3_p1 ;
  inv:groundedIn inv:BSER_App3_Ch2_Sec3_p2 ;
  inv:groundedIn inv:BSER_App3_Ch2_Sec6_p1 .

inv:Concept_AlternativeInvestmentClassification a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "대체투자분류"@ko ;
  rdfs:comment "LP출자가 대체투자에 해당하는지 분류. 핵심 원칙: LP출자라고 하여 무조건 대체투자에 해당하지 않음. LP출자는 집합투자기구를 활용한 간접 투자이며, 펀드의 최종 투자 대상이 투자등급 이상 기업이거나 상장사인 경우에는 대체투자에 해당하지 않음. 펀드 자체가 아닌 펀드의 최종 투자 대상을 기준으로 대체투자 여부를 분류해야 함."@ko ;
  inv:isCheckedBy inv:PreliminaryScreening
 ;
  inv:groundedIn inv:SFAAI .

inv:Concept_SoundnessGrading a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "자산건전성분류"@ko ;
  rdfs:comment "최종 피투자 회사의 건전성 등급 분류 (정상~추정손실). 펀드 자체가 아닌, 펀드를 통해 투자하려는 최종 투자 대상 회사 기준으로 평가. 사전심사 단계의 검토 항목."@ko ;
  inv:isCheckedBy inv:PreliminaryScreening
 .
  # ※ 향후 법령 매핑 보강 필요 (여신전문금융업감독규정 + 회계규정)

inv:Concept_CommitmentRegistration a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "약정등록"@ko ;
  rdfs:comment "확정된 한도와 조건의 약정 체결 및 시스템 등록."@ko ;
  inv:isCheckedBy inv:LimitCommitment
 .
  # ※ 향후 법령 매핑 보강 필요

inv:Concept_OngoingReporting a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "지속보고점검"@ko ;
  rdfs:comment "보고 의무 주체는 펀드 운용사(GP)이며 본 회사(LP)는 점검 주체. 운용사가 정기적으로 작성·제공하는 보고서를 본 회사가 수신하여 이상 유무를 확인하는 절차. 즉 본 회사가 직접 보고를 작성하는 게 아닌 수신·점검 행위에 해당."@ko ;
  inv:isCheckedBy inv:PostManagement
 ;
  inv:groundedIn inv:CMFA_Art89 ;
  inv:groundedIn inv:CMFA_Art90 .

inv:Concept_PortfolioMonitoring a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "포트폴리오모니터링"@ko ;
  rdfs:comment "투자 포트폴리오의 운용현황·리스크 지속 모니터링."@ko ;
  inv:isCheckedBy inv:PostManagement
 .
  # ※ 향후 법령 매핑 보강 필요

inv:Concept_ProductDefinition a owl:NamedIndividual, inv:RegulatoryConcept ;
  rdfs:label "상품정의"@ko ;
  rdfs:comment "LP출자 대상 펀드의 법적 형태 정의. 자본시장법상의 PEF·투자합자조합·투자신탁·투자회사 외에도 여신전문금융업법상 신기술사업투자조합, 벤처투자법상 벤처투자조합도 LP출자 대상 펀드 형태에 포함됨."@ko ;
  inv:isCheckedBy inv:InvestmentConsultation
 ;
  inv:groundedIn inv:CMFA_Art218 ;
  inv:groundedIn inv:CMFA_Art9 ;
  inv:groundedIn inv:SFA ;
  inv:groundedIn inv:VIA .

# === 4. 단계 → 개념 (checks 역방향)
# isCheckedBy의 역방향이 checks이므로 OWL 추론기가 자동 생성
# (원하면 명시도 가능하나 중복이라 생략)


# ════════════════════════════════════════════════════
# v1.3 향후 보강 과제 메모 (도메인 전문가 검토에서 도출)
# ════════════════════════════════════════════════════
# 1. RWA 자산분류별 청크 재구성:
#    - 별표 3을 주식익스포져, 기업익스포져, 중앙정부익스포져,
#      집합투자기구 익스포져 등 자산분류별로 재청킹 시 검색 정확도 향상 가능
# 2. SoundnessGrading 법령 매핑:
#    - 여신전문금융업감독규정 + 회계규정 자료 추가 확보 필요
# 3. CommitmentRegistration:
#    - 본질적으로 사적계약자치 + 전산 등록이라 별도 법령 매핑 불필요할 수 있음
#    - "법령에 매핑되지 않는 업무 절차의 존재"는 페이퍼 §6에서 인용 가능
# 4. PortfolioMonitoring:
#    - 여신전문금융회사 대체투자 리스크관리 모범규준(SFAAI)에 관련 표 존재 가능성
#    - 모범규준 자료 재검토 필요
# 5. 대체투자 모범규준 본문의 분류 표 확인 필요 (청크 누락 가능성)


# ════════════════════════════════════════════════════
# v1.4 추가 1: 어노테이션 속성 — 향후 보완 명시
# ════════════════════════════════════════════════════
inv:requiresFurtherMapping a owl:AnnotationProperty ;
  rdfs:label "향후 매핑 보완 필요"@ko ;
  rdfs:comment "RegulatoryConcept이 외부 법령에 매핑되어 있지 않은 경우, 그 사유와 향후 보완 방향을 명시하는 어노테이션 속성. 빈 매핑이 의도적인지 자료 부족인지 구분."@ko .

inv:mappingNote a owl:AnnotationProperty ;
  rdfs:label "매핑 메모"@ko ;
  rdfs:comment "RegulatoryConcept의 법령 매핑 상태에 대한 설명." .

# ════════════════════════════════════════════════════
# v1.4 추가 2: RWA 산정 근거 RegulatoryClause 인스턴스 명시 선언
# ════════════════════════════════════════════════════
# v0.8에서 청크 단위(BSER_App3_Ch2_Sec3_p1 등)로 분할되었으나
# 별도 RegulatoryClause 인스턴스로 선언되지 않아 SPARQL 추론 시 한계 발생
# v1.4에서 5개 핵심 청크를 명시 인스턴스로 선언

inv:BSER_App3_Ch1_p1 a owl:NamedIndividual, inv:RegulatoryClause ;
  rdfs:label "별표 3 제1장 (총칙)"@ko ;
  rdfs:comment "신용·운영리스크 위험가중자산에 대한 자기자본비율 산출 기준의 총칙. 표준방법(SA) 적용 원칙 정의."@ko ;
  inv:appliesToStage inv:PreliminaryScreening ;
  inv:hasObligationType inv:Obligation_LimitRule .

inv:BSER_App3_Ch2_Sec3_p1 a owl:NamedIndividual, inv:RegulatoryClause ;
  rdfs:label "별표 3 제2장 제3절 (위험가중치 1/3)"@ko ;
  rdfs:comment "자산별 위험가중치 적용 기준. 중앙정부·국제개발은행·국가·공공기관 등 익스포져 위험가중치 표 포함."@ko ;
  inv:appliesToStage inv:PreliminaryScreening ;
  inv:hasObligationType inv:Obligation_LimitRule .

inv:BSER_App3_Ch2_Sec3_p2 a owl:NamedIndividual, inv:RegulatoryClause ;
  rdfs:label "별표 3 제2장 제3절 (위험가중치 2/3)"@ko ;
  rdfs:comment "자산별 위험가중치 (계속). 회사·소매·주거용 부동산 등 익스포져 위험가중치 정의."@ko ;
  inv:appliesToStage inv:PreliminaryScreening ;
  inv:hasObligationType inv:Obligation_LimitRule .

inv:BSER_App3_Ch2_Sec6_p1 a owl:NamedIndividual, inv:RegulatoryClause ;
  rdfs:label "별표 3 제2장 제6절 (신용위험경감기법 1/?)"@ko ;
  rdfs:comment "담보·보증·신용파생상품을 통한 신용위험 경감 기법 적용 원칙."@ko ;
  inv:appliesToStage inv:PreliminaryScreening ;
  inv:hasObligationType inv:Obligation_LimitRule .

# ════════════════════════════════════════════════════
# v1.4 추가 3: ProductCode에 인수금융 추가
# ════════════════════════════════════════════════════
# LP출자와 동일 거래상대방(펀드)에 대해 동시 검토 가능한 상품군

inv:Product_AcquisitionFinance a owl:NamedIndividual, inv:ProductCode ;
  rdfs:label "인수금융"@ko ;
  rdfs:label "Acquisition Finance"@en ;
  rdfs:comment "M&A 인수자금 조달을 위한 대출 상품. LP출자와 다른 상품군이지만 같은 거래상대방(펀드)에 대해 동시 검토 가능. 본 회사 IB 부서에서 LP출자와 함께 검토되는 전형적 케이스."@ko .


# ════════════════════════════════════════════════════
# v1.4 추가 4: checks 관계 양방향 명시 (LLM 토큰 효율)
# ════════════════════════════════════════════════════
# 기존: isCheckedBy(Concept→Stage)만 명시, owl:inverseOf로 checks 추론
# 문제: LLM이 추론된 triple을 사용하려면 추가 토큰 소요
# 해결: 양방향 모두 명시적 triple로 박음

inv:CustomerRegistration inv:checks inv:Concept_CustomerIdentification ;
  inv:checks inv:Concept_ConsumerClassification .

inv:InvestmentConsultation inv:checks inv:Concept_SuitabilityCheck ;
  inv:checks inv:Concept_ExplanationDuty ;
  inv:checks inv:Concept_ProductDefinition .

inv:PreliminaryScreening inv:checks inv:Concept_TotalExposureLimit ;
  inv:checks inv:Concept_RWA_Calculation ;
  inv:checks inv:Concept_AlternativeInvestmentClassification ;
  inv:checks inv:Concept_SoundnessGrading .

inv:LimitCommitment inv:checks inv:Concept_CommitmentRegistration .

inv:PostManagement inv:checks inv:Concept_OngoingReporting ;
  inv:checks inv:Concept_PortfolioMonitoring .

# ════════════════════════════════════════════════════
# v1.4 추가 5: 근거조항 없는 Concept에 향후 보완 명시
# ════════════════════════════════════════════════════

inv:Concept_SoundnessGrading inv:requiresFurtherMapping
  "여신전문금융업감독규정 + 회계규정 자료 추가 확보 필요. 사전심사 단계에서 최종 피투자 회사의 건전성 등급을 분류하는 절차이나, 본 프로토타입에서는 해당 규정 청크 미확보."@ko .

inv:Concept_CommitmentRegistration inv:requiresFurtherMapping
  "본질적으로 사적계약자치 영역으로 별도 외부 법령 매핑이 불필요할 가능성. 약정 체결 자체는 민법·상법 일반 원칙에 따르며, 회사 내부 규정과 전산 등록 절차가 본 절차의 본질. 이는 \"법령에 직접 매핑되지 않는 업무 절차의 존재\" 사례."@ko .

inv:Concept_PortfolioMonitoring inv:requiresFurtherMapping
  "여신전문금융회사 대체투자 리스크관리 모범규준(SFAAI)에 관련 표 존재 가능성. 모범규준 별표 1 본문 청크 누락 확인됨, 추가 자료 확보 후 매핑 보강 예정."@ko .

inv:Concept_RWA_Calculation inv:mappingNote
  "v1.4에서 별표 3 청크들을 별도 RegulatoryClause 인스턴스로 명시 선언. 향후 자산분류별(중앙정부·기업·주식·집합투자기구 등) 세분화된 청크 재구성 시 매핑 정확도 추가 향상 예정."@ko .

inv:Concept_AlternativeInvestmentClassification inv:mappingNote
  "여전사 대체투자 모범규준 본문(SFAAI)에 매핑되었으나, 별표 1(대체투자 범위·분류 표) 청크가 누락됨. 향후 별표 1 추가 후 매핑 강화 예정."@ko .


# ════════════════════════════════════════════════════
# v1.4 추가 6: 데모 인스턴스 시나리오 현실화
# ════════════════════════════════════════════════════
# 기존 v1.0 시나리오: ABC PEF 출자 검토 (LP출자) → 우선주/전환사채로 분기
#   문제: LP출자는 트렌치 형태로 분기되지 않으며 단일 출자 형태
#   (우선주/전환사채는 직접 인수투자 또는 메자닌투자에 해당)
#
# v1.4 시나리오: ABC펀드에 대한 LP출자 + 인수금융 동시 검토
#   - 한 거래상대방(펀드/GP)에 대해 두 가지 다른 상품을 동시 검토
#   - 한 상담 채번 → LP출자 사전협의 + 인수금융 사전협의 각각 채번
#   - 본 회사 IB 부서의 전형적 검토 패턴

# --- v1.4 데모 인스턴스 (현실화 시나리오) ---
inv:Demo_Investment_002 a owl:NamedIndividual, inv:Investment ;
  rdfs:label "ABC펀드 출자·인수금융 동시 검토 (가상)"@ko ;
  rdfs:comment "ABC 자산운용 GP의 신규 펀드에 대한 LP출자(50억) + 인수금융(100억) 동시 검토 1건. 한 상담 채번에서 두 상품으로 분기됨."@ko ;
  inv:hasOrigin inv:Demo_Consultation_C2026_0050 ;
  inv:hasState inv:State_Drawdown ;
  inv:managedByGP inv:Demo_GP_ABC .

# --- 단계 1: 상담 (Consultation) ---
inv:Demo_Consultation_C2026_0050 a owl:NamedIndividual, inv:Consultation ;
  rdfs:label "C-2026-0050 상담건 (가상)"@ko ;
  rdfs:comment "ABC 자산운용 GP의 신규 펀드 출자·인수금융 동시 검토 상담. 총 150억 검토 (LP출자 50억 + 인수금융 100억)."@ko ;
  inv:hasNextStep inv:Demo_Screening_S2026_0110 ,
                   inv:Demo_Screening_S2026_0111 .   # ← 상품 유형별 분기

# --- 단계 2 (상품별 분기): 사전협의 ---
inv:Demo_Screening_S2026_0110 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "S-2026-0110 사전협의 (LP출자 50억)"@ko ;
  rdfs:comment "ABC펀드에 대한 LP출자 50억 사전협의. 약정·실행까지 진행. 대체투자 분류·RWA 산정 검토."@ko ;
  inv:precededBy inv:Demo_Consultation_C2026_0050 ;
  inv:hasNextStep inv:Demo_Review_R2026_0210 ;
  inv:hasProductType inv:Product_PEF ;
  inv:hasTranche inv:Tranche_Equity .

inv:Demo_Screening_S2026_0111 a owl:NamedIndividual, inv:Screening ;
  rdfs:label "S-2026-0111 사전협의 (인수금융 100억)"@ko ;
  rdfs:comment "ABC펀드의 M&A 인수금융 100억 사전협의. 예비검토 단계까지만 진행."@ko ;
  inv:precededBy inv:Demo_Consultation_C2026_0050 ;
  inv:hasNextStep inv:Demo_Review_R2026_0211 ;
  inv:hasProductType inv:Product_AcquisitionFinance ;
  inv:hasTranche inv:Tranche_Senior .

# --- 가지 1 후속 (LP출자 50억 → 약정·실행까지) ---
inv:Demo_Review_R2026_0210 a owl:NamedIndividual, inv:Review ;
  rdfs:label "R-2026-0210 예비검토 (LP출자)"@ko ;
  inv:precededBy inv:Demo_Screening_S2026_0110 ;
  inv:hasNextStep inv:Demo_WorkingReview_W2026_0105 .

inv:Demo_WorkingReview_W2026_0105 a owl:NamedIndividual, inv:WorkingReview ;
  rdfs:label "W-2026-0105 실무협의회 (LP출자)"@ko ;
  inv:precededBy inv:Demo_Review_R2026_0210 ;
  inv:hasNextStep inv:Demo_Proposal_P2026_0072 .

inv:Demo_Proposal_P2026_0072 a owl:NamedIndividual, inv:Proposal ;
  rdfs:label "P-2026-0072 품의 (LP출자)"@ko ;
  inv:precededBy inv:Demo_WorkingReview_W2026_0105 ;
  inv:hasNextStep inv:Demo_Commitment_A2026_0040 .

inv:Demo_Commitment_A2026_0040 a owl:NamedIndividual, inv:Commitment ;
  rdfs:label "A-2026-0040 약정 (LP출자 50억)"@ko ;
  inv:precededBy inv:Demo_Proposal_P2026_0072 ;
  inv:hasCommitmentLimit "5000000000"^^xsd:decimal ;
  inv:hasIndividualApproval inv:Demo_Drawdown_D2026_0095 .

inv:Demo_Drawdown_D2026_0095 a owl:NamedIndividual, inv:DrawdownExecution ;
  rdfs:label "D-2026-0095 개별품의 1차 (30억 인출)"@ko ;
  inv:hasExecutionDate "2026-04-20"^^xsd:date .

# --- 가지 2 후속 (인수금융 100억 → 예비검토에서 정체) ---
inv:Demo_Review_R2026_0211 a owl:NamedIndividual, inv:Review ;
  rdfs:label "R-2026-0211 예비검토 (인수금융)"@ko ;
  rdfs:comment "인수금융 가지는 예비검토 단계에서 정체 (실무협의회 미상정). 신용리스크 산정 결과 보강 필요로 보류."@ko ;
  inv:precededBy inv:Demo_Screening_S2026_0111 .



# ════════════════════════════════════════════════════
# v1.5 추가 1: 별표 3 자산분류 20개를 RegulatoryClause로 명시 선언
# ════════════════════════════════════════════════════
# 청크 v10에서 별표 3을 자산분류 단위로 재구성 (도메인 전문가 입력 기반)
# TTL에서도 각 자산분류를 별도 RegulatoryClause 인스턴스로 명시 선언하여
# Concept_RWA_Calculation의 groundedIn으로 연결

inv:BSER_App3_Asset_CentralGov a owl:NamedIndividual, inv:RegulatoryClause ;
  rdfs:label "별표 3 자산분류: 중앙정부 및 중앙은행 익스포져"@ko ;
  rdfs:label "Annex 3 Asset Class: CentralGov"@en ;
  skos:altLabel "국채"@ko ;
  skos:altLabel "국가 익스포져"@ko ;
  skos:altLabel "Sovereign Exposure"@ko ;
  skos:altLabel "Central Government"@ko ;
  rdfs:comment "별표 3 제2장 제3절의 중앙정부 및 중앙은행 익스포져 분류. RWA 산정 시 본 자산분류에 해당하는 익스포져에 대해 정의된 위험가중치 적용."@ko ;
  inv:appliesToStage inv:PreliminaryScreening ;
